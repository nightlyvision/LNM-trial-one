# Copy values from the Daraja app / test credentials page into Netlify's
# function-scoped environment variables. Do not commit real credentials.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_STK_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://YOUR-SITE.netlify.app/.netlify/functions/collect
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline

# B2B Express Checkout (till-operator prompt). Requires Safaricom enablement.
# Set receiver to the shortcode/till Safaricom confirms should receive funds.
MPESA_B2B_RECEIVER_SHORTCODE=
MPESA_B2B_PARTNER_NAME=
MPESA_B2B_CALLBACK_URL=https://YOUR-SITE.netlify.app/.netlify/functions/collect
